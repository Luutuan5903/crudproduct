<!-- Modal Update Product -->
@using Abp.Authorization.Users
@using Acme.SimpleTaskApp.Web.Models.Common.Modals
@using Acme.SimpleTaskApp.Web.Models.Products
@model EditProductViewModel

@{
    Layout = null;
}

@await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(("Chỉnh Sửa Sản Phẩm")))

<form name="ProductEditForm" role="form" class="form-horizontal" enctype="multipart/form-data" method="post">
    <input type="hidden" name="Id" value="@Model.Product.Id" />

    <div class="modal-body">
        <div class="tab-content mt-4">
            <div role="tabpanel" class="tab-pane container active" id="edit-product-details">

                <!-- Product Name -->
                <div class="form-group row required">
                    <label class="col-md-3 col-form-label" for="name">@("Tên sản phẩm")</label>
                    <div class="col-md-9">
                        <input id="name" type="text" class="form-control" name="Name" value="@Model.Product.Name" required>
                    </div>
                </div>

                <!-- Product Image -->
                <div class="form-group row required">
                    <label class="col-md-3 col-form-label" for="image">@("Hình ảnh")</label>
                    <div class="col-md-9">
                        <input id="image" type="file" class="form-control" name="Images">
                    </div>
                </div>

                <!-- Display Product Image -->
                <div class="form-group row">
                    <label class="col-md-3 col-form-label" style="font-weight: 700">@("Ảnh")</label>
                    <div class="col-md-9">
                        <img src="@Model.Product.Images" style="max-height: 60px; margin-left: 10px;" alt="image" />
                    </div>
                </div>

                <!-- Product Price -->
                <div class="form-group row required">
                    <label class="col-md-3 col-form-label" for="price">@("Giá")</label>
                    <div class="col-md-9">
                        <input id="price" type="number" class="form-control" name="Price" value="@Model.Product.Price.ToString("0")" required>
                    </div>
                </div>

                <!-- Stock Quantity -->
                <div class="form-group row required">
                    <label class="col-md-3 col-form-label" for="stockQuantity">@("Số lượng trong kho")</label>
                    <div class="col-md-9">
                        <input id="stockQuantity" type="number" class="form-control" name="StockQuantity" value="@Model.Product.StockQuantity" required>
                    </div>
                </div>

                <!-- Product Description -->
                <div class="form-group row required">
                    <label class="col-md-3 col-form-label" for="description">@("Mô tả")</label>
                    <div class="col-md-9">
                        <textarea id="description" class="form-control" name="Description" required>@Model.Product.Description</textarea>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>

<script src="~/view-resources/Views/Products/_EditModal.js" asp-append-version="true"></script>
