@using Acme.SimpleTaskApp.Authorization
@using Acme.SimpleTaskApp.Web.Startup
@using Acme.SimpleTaskApp.Web.Models.Products
@model ProductViewModel
@{
    ViewBag.Title = L("Products");
    ViewBag.CurrentPageName = PageNames.Products;
}
@section scripts
{
    <environment names="Development">
        <script src="~/view-resources/Views/Products/Index.js" asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/Products/Index.min.js" asp-append-version="true"></script>
    </environment>
    
}

@{
    var canCreate = await PermissionChecker.IsGrantedAsync(PermissionNames.Pages_Products_Create);
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>@L("Products")</h1>
            </div>
           

        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                                @if (canCreate)
                                {
                                    <button class=" btn bg-blue float-sm" data-toggle="modal" data-target="#ProductCreateModal">
                                        <i class="fa fa-plus-square"></i>
                                        @L("CreateNew")
                                    </button>
                                }
                            </div>
                            <div class="col-md-6">
                                @await Html.PartialAsync("~/Views/Products/IndexAdvancedSearch.cshtml")
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="ProductsTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th scope="col" class="text-center">@L("ProductName")</th>
                                        <th scope="col" class="text-center">@L("Image")</th>
                                        <th scope="col" class="text-center">@L("Price")</th>
                                        <th scope="col" class="text-center">@L("StockQuantity")</th>
                                        <th scope="col" class="text-center">@L("ProductDescription")</th>
                                        <th scope="col" class="text-center">@L("CreationTime")</th>
                                        <th scope="col" class="text-center">@L("EditTime")</th>
                                        <th scope="col" class="text-center">@L("Category")</th>
                                        <th style="width: 150px" scope="col" class="text-center">@L("Actions")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/Products/_CreateProductModal.cshtml", Model)

<div class="modal fade" id="ProductEditModal" tabindex="-1" role="dialog" aria-labelledby="ProductEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>
